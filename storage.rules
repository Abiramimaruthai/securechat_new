rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && request.auth.uid in firestore.get(
          /databases/(default)/documents/chats/$(chatId)
        ).data.participants;
    }

    match /images/{chatId}/{fileName} {
      allow read, write: if isChatParticipant(chatId);
    }

    match /videos/{chatId}/{fileName} {
      allow read, write: if isChatParticipant(chatId)
        && request.resource.size < 10 * 1024 * 1024;
    }

    match /voice/{chatId}/{fileName} {
      allow read, write: if isChatParticipant(chatId);
    }
  }
}
